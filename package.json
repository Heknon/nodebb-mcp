{
  "name": "nodebb-plugin-mcp",
  "version": "0.2.1",
  "description": "MCP for NodeBB: the forum serves MCP at /mcp, and each person connects their AI client with their own forum account. Answers, investigations, and Shotef ticket work, within their forum permissions.",
  "type": "module",
  "bin": {
    "nodebb-mcp": "dist/index.js"
  },
  "main": "library.cjs",
  "files": [
    "dist",
    "resources",
    "templates",
    "public",
    "library.cjs",
    "plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.e2e.test.js\"",
    "e2e": "bash e2e/run.sh",
    "check": "npm run build && npm test"
  },
  "keywords": [
    "nodebb",
    "nodebb-plugin",
    "mcp",
    "model-context-protocol",
    "forum"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "nbbpm": {
    "compatibility": "^4.0.0"
  }
}
