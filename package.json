{
  "name": "nodebb-mcp",
  "version": "0.1.0",
  "description": "MCP server for investigating issues, finding answers, and working triage tickets on a NodeBB forum, with optional Q&A and Shotef integration.",
  "type": "module",
  "bin": {
    "nodebb-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "resources",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.e2e.test.js\"",
    "e2e": "bash e2e/run.sh",
    "check": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "nodebb",
    "forum",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
